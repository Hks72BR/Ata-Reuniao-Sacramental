# Copie para .env e preencha os valores. Não versione arquivos com valores reais.
# PINs: exatamente quatro dígitos. PIN ausente ou inválido desabilita esse acesso.
VITE_SACRAMENTAL_PIN=
VITE_BAPTISMAL_PIN=
VITE_WARD_COUNCIL_PIN=
VITE_DELETE_PIN=

# Opcional: PIN específico para criar/excluir atas do conselho.
# Se vazio, utiliza VITE_DELETE_PIN (também configurado no ambiente).
VITE_WARD_COUNCIL_ADMIN_PIN=

# Configuração pública do aplicativo Firebase: obtenha no console do seu projeto.
# As seis variáveis são obrigatórias; não há projeto de fallback.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Use npm run dev:conselho para testes isolados no navegador.
# O script ativa VITE_WARD_COUNCIL_LOCAL somente durante o desenvolvimento.
# Em produção, configure as variáveis na hospedagem antes de gerar o build.
# Variáveis VITE_* são incluídas no cliente; permissões reais dependem do servidor.
